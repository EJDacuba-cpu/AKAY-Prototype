# Same-origin local development through the Vite proxy.
VITE_API_BASE_URL=/api

# Cloudflare Turnstile public site key for the AKAY Login widget.
# Local/testing may use Cloudflare's official dummy sitekey 1x00000000000000000000AA.
# Production must use the real site key; dummy keys are refused in production builds.
VITE_TURNSTILE_SITE_KEY=

# Development-server settings are not exposed to browser code.
AKAY_DEV_API_PROXY_TARGET=http://localhost:8000
AKAY_VITE_ALLOWED_HOSTS=

# Production example:
# VITE_API_BASE_URL=https://api.example.gov.ph/api
